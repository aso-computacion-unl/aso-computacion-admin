# Replace every __REPLACE_*__ example value before using its service.
# Runtime validation rejects placeholders for ADMIN_PASSWORD, ADMIN_SECRET and the CLOUDINARY_* credentials.

# Local development database (Neon in production). Do not point this at the
# isolated test database.
DATABASE_URL=__REPLACE_DATABASE_URL__

# Isolated Prisma integration database only. Before running `npm run test:integration`,
# TEST_DATABASE_URL must exactly match this component contract: protocol `postgresql`,
# username `postgres`, password `postgres`, host `127.0.0.1`, port `54329`,
# database `aso_computacion_admin_test`, and query `schema=public`.
# Never reuse DATABASE_URL or point this command at any non-disposable database.
TEST_DATABASE_URL=__REPLACE_TEST_DATABASE_URL__

# Shared emergency password (break-glass) and the secret that signs session cookies.
# Use a long random value for ADMIN_SECRET (at least 32 characters) and a long random
# ADMIN_PASSWORD (at least 16 characters, enforced): the login throttle slows guessing per
# client, the password strength is what stops a distributed attack. A missing, placeholder
# or shorter-than-16 ADMIN_PASSWORD disables login and logs an error. ADMIN_SECRET also signs
# the long-lived "known device" cookie; rotating it logs everyone out and forgets known devices.
ADMIN_PASSWORD=__REPLACE_ADMIN_PASSWORD__
ADMIN_SECRET=__REPLACE_ADMIN_SECRET__

# Google sign-in (see docs/DEPLOY.md, "Sign-in with Google, users and roles"). Google counts as configured only
# when all three are set; until then the shared-password login above stays on, so nothing is locked out.
# AUTH_URL is the public origin of this admin (https, no path), used to build the OAuth redirect URI
# `${AUTH_URL}/auth/google/callback`; http is accepted only for localhost.
GOOGLE_CLIENT_ID=__REPLACE_GOOGLE_CLIENT_ID__
GOOGLE_CLIENT_SECRET=__REPLACE_GOOGLE_CLIENT_SECRET__
AUTH_URL=http://localhost:3000
# Comma-separated emails that become ADMIN on their first successful Google login, if no such user exists yet.
ADMIN_BOOTSTRAP_EMAILS=
# Optional: only Google accounts of this domain can log in (e.g. unl.edu.ec). Empty: any verified account that is registered.
ALLOWED_EMAIL_DOMAIN=
# Break-glass: the shared-password login stays available once Google is configured only with the exact value 1.
# Emergency use only (every use is audited, shown with a warning banner, and can be revoked).
BREAK_GLASS_PASSWORD_LOGIN=

# Cloudinary image storage (server-side only). CLOUDINARY_FOLDER is the base
# folder for every upload (default `aso-computacion`); each feature adds its own
# subfolder (e.g. `events`). Allowed characters: letters, digits, `_`, `-`, `/`.
CLOUDINARY_CLOUD_NAME=__REPLACE_CLOUDINARY_CLOUD_NAME__
CLOUDINARY_API_KEY=__REPLACE_CLOUDINARY_API_KEY__
CLOUDINARY_API_SECRET=__REPLACE_CLOUDINARY_API_SECRET__
CLOUDINARY_FOLDER=aso-computacion

# Browser origins allowed to read GET /api/public/content (comma-separated, exact origins, never `*`):
# the landing's production origin, plus http://localhost:4321 for local development. Unset grants no
# browser origin; the landing's build-time fetch is server-side and does not need it.
PUBLIC_CORS_ORIGINS=https://landing.example,http://localhost:4321

# Error tracking (Sentry). Entirely off while the DSNs are empty: no network, no warnings. Create a
# Sentry project (platform: Next.js), copy its DSN, and set the SAME DSN in both variables in Vercel:
# SENTRY_DSN for the server and edge runtimes, NEXT_PUBLIC_SENTRY_DSN for the browser (it is public by design).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Share of requests traced, from 0 to 1 (default 0.1). The NEXT_PUBLIC_ one is for the browser.
SENTRY_TRACES_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# Source-map upload at build time. Uploads only when the token is set (Vercel Production); never commit it.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Cloudflare Pages deploy hook for the landing (https only; the token is part of the URL, keep it
# secret). POSTed, debounced, after every successful admin edit. Leave empty to disable rebuilds.
CLOUDFLARE_DEPLOY_HOOK_URL=
