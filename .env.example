# Replace every __REPLACE_*__ example value before using its service.
# Runtime validation rejects placeholders for ADMIN_PASSWORD and ADMIN_SECRET.

# Local development database (Neon in production). Do not point this at the
# isolated test database.
DATABASE_URL=__REPLACE_DATABASE_URL__

# Isolated Prisma integration database only. Before running `npm run test:integration`,
# TEST_DATABASE_URL must exactly match this component contract: protocol `postgresql`,
# username `postgres`, password `postgres`, host `127.0.0.1`, port `54329`,
# database `aso_computacion_admin_test`, and query `schema=public`.
# Never reuse DATABASE_URL or point this command at any non-disposable database.
TEST_DATABASE_URL=__REPLACE_TEST_DATABASE_URL__

# Shared administrator password and the secret that signs session cookies.
# Use a long random value for ADMIN_SECRET (at least 32 characters).
ADMIN_PASSWORD=__REPLACE_ADMIN_PASSWORD__
ADMIN_SECRET=__REPLACE_ADMIN_SECRET__
