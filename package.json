{
  "name": "aso-computacion-admin",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "typecheck": "next typegen && tsc --noEmit",
    "db:dev": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:dev:stop": "docker compose -f docker-compose.dev.yml stop",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "node scripts/run-prisma-integration-tests.mjs",
    "e2e": "node scripts/run-e2e.mjs",
    "e2e:browsers": "playwright install --with-deps chromium",
    "e2e:live": "playwright test -c playwright.live.config.ts",
    "seed:landing": "vite-node --config scripts/seed.vite.config.ts scripts/seed-from-landing.ts --",
    "seed:demo": "vite-node --config scripts/seed.vite.config.ts scripts/seed-demo.ts --",
    "audit:ui": "vite-node --config scripts/seed.vite.config.ts scripts/ui-audit/run.ts --"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@fontsource/audiowide": "^5.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@sentry/nextjs": "^11.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "arctic": "^3.7.0",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "jose": "^6.2.14",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.12.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "9.18.0",
    "eslint-config-next": "16.4.5",
    "jsdom": "^31.0.0",
    "prisma": "7.10.1",
    "typescript": "5.7.3",
    "vite": "7.3.7",
    "vite-node": "^3.2.4",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "postcss": ">=8.5.23",
    "sharp": ">=0.35.5",
    "source-map-js": ">=1.2.2",
    "deepmerge-ts": ">=8.0.2"
  }
}
