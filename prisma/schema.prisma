generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventType {
  taller
  charla
  evento
  comunidad
}

model Event {
  id            String       @id
  // Unique among live rows (deletedAt IS NULL): partial index "Event_slug_live_key", raw SQL in the
  // add_soft_delete migration because Prisma cannot express it. A trashed event keeps its slug.
  slug          String
  title         String
  description   String?
  // Calendar date without time zone; a future date reads as upcoming on the landing.
  date          DateTime?    @db.Date
  // "day" or "month" (CHECK in the migration). With "month" the date is the first of the month.
  datePrecision String       @default("day")
  type          EventType?
  commitMessage String?
  hora          String?
  lugar         String?
  para          String?
  featured      Boolean      @default(false)
  linkUrl       String?
  linkLabel     String?
  highlights    String[]     @default([])
  isPublished   Boolean      @default(false)
  // Set when moved to the trash (never published then); null while live. Its photos stay attached.
  deletedAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime
  photos        EventPhoto[]

  @@index([isPublished, date])
}

model EventPhoto {
  id        String   @id
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  url       String
  publicId  String   @unique
  width     Int
  height    Int
  alt       String
  sortOrder Int
  // Photos are deactivated, never deleted: the stored asset is retained.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([eventId, isActive, sortOrder])
}

model Faq {
  id          String    @id
  question    String
  answer      String
  /// Optional `git help <command>` topic; unique among live FAQs (partial index "Faq_command_live_key", raw SQL in the
  /// add_soft_delete migration; the application also keeps it apart from free commands).
  command     String?
  sortOrder   Int
  isPublished Boolean   @default(false)
  // Set when moved to the trash (never published then); null while live.
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime

  @@index([sortOrder, createdAt])
}

/// A free terminal command: `❯ <command>` prints `output` on the landing and is listed in `help` with `description`.
model TerminalCommand {
  id          String    @id
  // Unique among live rows: partial index "TerminalCommand_command_live_key" (raw SQL, add_soft_delete migration).
  command     String
  description String
  output      String
  sortOrder   Int
  isPublished Boolean   @default(false)
  // Set when moved to the trash (never published then); null while live.
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime

  @@index([sortOrder, createdAt])
}

model SocialLink {
  id          String    @id
  // One of SOCIAL_PLATFORMS; kept as text so adding a platform needs no migration.
  platform    String
  label       String
  handle      String
  url         String
  note        String?
  blurb       String?
  sortOrder   Int
  isPublished Boolean   @default(false)
  // Set when moved to the trash (never published then); null while live.
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime

  @@index([sortOrder, createdAt])
}

model Pillar {
  id            String    @id
  word          String
  title         String
  text          String
  // The five image columns are all set or all null (CHECK in the migration).
  imageUrl      String?
  imagePublicId String?   @unique
  imageWidth    Int?
  imageHeight   Int?
  imageAlt      String?
  sortOrder     Int
  isPublished   Boolean   @default(false)
  // Set when moved to the trash (never published then); null while live.
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime

  @@index([sortOrder, createdAt])
}

model NewsItem {
  id            String    @id
  // Unique among live rows: partial index "NewsItem_slug_live_key" (raw SQL, add_soft_delete migration).
  slug          String
  title         String
  summary       String
  // Markdown subset, stored as written; the landing renders it safely.
  body          String
  // Calendar date without time zone, shown on the landing; newest first.
  publishedAt   DateTime  @db.Date
  // The five cover columns are all set or all null (CHECK in the migration).
  coverUrl      String?
  coverPublicId String?   @unique
  coverWidth    Int?
  coverHeight   Int?
  coverAlt      String?
  isPublished   Boolean   @default(false)
  // Set when moved to the trash (never published then); null while live.
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime

  @@index([publishedAt(sort: Desc), createdAt(sort: Desc)])
}

// Singleton: the only row has id "site" (CHECK in the migration).
model SiteSettings {
  id          String   @id
  tagline     String
  description String
  about       String
  updatedAt   DateTime
}

// Singleton: the outcome of the LAST landing deploy-hook attempt, id "landing" (CHECK in the migration).
// Never stores the hook URL (it carries a secret token): only the time, the result and a coarse reason.
model DeployStatus {
  id          String   @id
  attemptedAt DateTime
  ok          Boolean
  httpStatus  Int?
  errorKind   String?
}

// S4: name, role and photo only. No contact column may be added here.
model BoardMember {
  id            String    @id
  name          String
  role          String
  // The five photo columns are all set or all null; a published member needs a photo (CHECKs in the migration).
  photoUrl      String?
  photoPublicId String?   @unique
  photoWidth    Int?
  photoHeight   Int?
  photoAlt      String?
  sortOrder     Int
  isPublished   Boolean   @default(false)
  // Set when moved to the trash (never published then); null while live.
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime

  @@index([sortOrder, createdAt])
}

// Login throttle shared by every instance (Vercel runs many). One row per client key:
// `attempts` login tries in the current window and when the last one happened, as
// epoch milliseconds (BIGINT) so the atomic upsert needs no time zone handling.
model LoginAttempt {
  key           String @id
  attempts      Int
  lastAttemptAt BigInt

  @@index([lastAttemptAt])
}

enum UserRole {
  ADMIN
  EDITOR
}

// Who an audit entry or a session belongs to. "system" is only used by audit entries.
enum ActorKind {
  user
  break_glass
  system
}

// S5: people allowed into the admin, managed from the Users page. The email is stored lower-cased
// (CHECK in the migration) and is the only identity Google login is matched against.
// Users are deactivated, never deleted: the audit log keeps referring to them by id.
model User {
  id          String    @id
  email       String    @unique
  name        String
  role        UserRole
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?
  sessions    Session[]
}

// One row per login, checked by the guard on every action and protected page, so a session can be
// revoked at once. A break-glass login (shared-password emergency access) has kind "break_glass" and
// no user (CHECK in the migration). `ipHash` is a salted hash, never the address; `userAgent` is
// truncated by the app (CHECK keeps it short).
model Session {
  id         String    @id
  kind       ActorKind @default(user)
  userId     String?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime
  userAgent  String?
  ipHash     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

// Append-only record of who changed what. Holds names and ids only: no content bodies, no secrets.
// `actorUserId` has no foreign key on purpose: the entry must outlive anything that happens to the user.
model AuditLog {
  id          String    @id
  at          DateTime  @default(now())
  actorUserId String?
  actorKind   ActorKind
  action      String
  entityType  String
  entityId    String?
  summary     String

  @@index([at(sort: Desc)])
  @@index([entityType, at(sort: Desc)])
  @@index([actorUserId, at(sort: Desc)])
}

// S11: a single-use link that lets one person into the admin, bound to their email, with the role an
// ADMIN chose. Only the SHA-256 of the link's token is stored, never the token. The User row is created
// when the invite is redeemed. Pending means not used, not revoked and not expired; used and revoked
// are exclusive, and a used invite names the user it created (CHECKs in the migration).
// `createdById` and `usedByUserId` have no foreign key, like the audit log: the row outlives the users.
model AdminInvite {
  id           String    @id
  tokenHash    String    @unique
  email        String
  role         UserRole
  createdById  String?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  usedAt       DateTime?
  usedByUserId String?
  revokedAt    DateTime?

  @@index([email])
  @@index([expiresAt])
}

enum ForumMemberStatus {
  ACTIVE
  SUSPENDED
}

enum ForumReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// Students who signed in to the forum with their institutional Google account. They are NOT rows of
// `User` (the admin's people): a forum session can never become an admin session. `email` is
// lower-cased (CHECK in the migration), is never shown publicly, and `googleSub` is the stable
// identity. Suspended members keep their rows: their posts and the moderation trail still point at them.
model ForumMember {
  id          String            @id
  email       String            @unique
  googleSub   String            @unique
  displayName String
  status      ForumMemberStatus @default(ACTIVE)
  suspendedAt DateTime?
  // Id of the admin `User` who suspended the account; no foreign key, like AuditLog's actor.
  suspendedBy String?
  createdAt   DateTime          @default(now())
  lastLoginAt DateTime?
  sessions    ForumSession[]
  threads     ForumThread[]
  replies     ForumReply[]
  reactions   ForumReaction[]
  reports     ForumReport[]
}

// One row per forum login, checked by the forum guard on every request, so a session can be revoked
// at once (and a suspended member's sessions stop working). `ipHash` is a salted hash, never the address.
model ForumSession {
  id         String      @id
  memberId   String
  createdAt  DateTime    @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime
  userAgent  String?
  ipHash     String?
  member     ForumMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, revokedAt])
  @@index([expiresAt])
}

model ForumCategory {
  id          String        @id
  slug        String        @unique
  name        String
  description String?
  sortOrder   Int
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  threads     ForumThread[]

  @@index([sortOrder, createdAt])
}

// A hidden thread (hiddenAt) is invisible to students; a locked one (lockedAt) accepts no replies.
// `hiddenBy` / `lockedBy` are admin `User` ids with no foreign key (the moderation trail is the AuditLog).
// `bestReplyId` is the answer the author marked; the application keeps it a reply of this same thread.
model ForumThread {
  id             String          @id
  categoryId     String
  authorId       String
  title          String
  body           String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime
  // Set only by an edit of the title or body.
  editedAt       DateTime?
  // Creation, then the latest visible reply: the order of the thread list.
  lastActivityAt DateTime
  lockedAt       DateTime?
  lockedBy       String?
  hiddenAt       DateTime?
  hiddenBy       String?
  bestReplyId    String?         @unique
  category       ForumCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  author         ForumMember     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  bestReply      ForumReply?     @relation("ForumBestReply", fields: [bestReplyId], references: [id], onDelete: SetNull)
  replies        ForumReply[]    @relation("ForumThreadReplies")
  reactions      ForumReaction[]
  reports        ForumReport[]

  @@index([categoryId, lastActivityAt(sort: Desc)])
  @@index([authorId, createdAt])
}

model ForumReply {
  id        String          @id
  threadId  String
  authorId  String
  body      String
  createdAt DateTime        @default(now())
  updatedAt DateTime
  editedAt  DateTime?
  hiddenAt  DateTime?
  hiddenBy  String?
  thread    ForumThread     @relation("ForumThreadReplies", fields: [threadId], references: [id], onDelete: Cascade)
  author    ForumMember     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  bestOf    ForumThread?    @relation("ForumBestReply")
  reactions ForumReaction[]
  reports   ForumReport[]

  @@index([threadId, createdAt])
  @@index([authorId, createdAt])
}

// A "me sirvió" vote on a thread or a reply: exactly one target (CHECK in the migration), and one
// vote per member per target (the unique indexes; Postgres treats the null target as distinct).
model ForumReaction {
  id        String       @id
  memberId  String
  threadId  String?
  replyId   String?
  createdAt DateTime     @default(now())
  member    ForumMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  thread    ForumThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  reply     ForumReply?  @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([memberId, threadId])
  @@unique([memberId, replyId])
  @@index([threadId])
  @@index([replyId])
}

// A student's report of a thread or a reply: exactly one target (CHECK), one open-or-closed report per
// member per target. `status` OPEN until a moderator closes it: RESOLVED (acted on) or DISMISSED, with the
// moderator's id and optional note. The reporter's identity is for moderators only.
model ForumReport {
  id             String            @id
  reporterId     String
  threadId       String?
  replyId        String?
  reason         String
  status         ForumReportStatus @default(OPEN)
  createdAt      DateTime          @default(now())
  resolvedAt     DateTime?
  // Id of the admin `User` who closed it; no foreign key.
  resolvedBy     String?
  resolutionNote String?
  reporter       ForumMember       @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  thread         ForumThread?      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  reply          ForumReply?       @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([reporterId, threadId])
  @@unique([reporterId, replyId])
  @@index([status, createdAt])
  @@index([threadId])
  @@index([replyId])
}
